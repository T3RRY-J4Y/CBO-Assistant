# Copy this file to .env and fill in your values.

# Chat mode: "kb" (default) answers straight from knowledge-base.txt with no
# AI and no API key. Set to "ai" to use Claude, which needs the key below.
CHAT_MODE=kb

# Only needed when CHAT_MODE=ai. Get a key at https://console.anthropic.com.
# ANTHROPIC_API_KEY=your-key-here

# The admin account is created from these values on first start, and the
# password is refreshed from here on every start. Use at least 8 characters.
# Dummy credentials for local testing. Change them before deploying.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=Admin@12345

# Optional demo CBO partner account, created already approved and refreshed
# on every start. Remove both lines to disable it.
CBO_EMAIL=cbo@example.org
CBO_PASSWORD=Cbo@12345

# Optional overrides. The default model is claude-haiku-4-5-20251001;
# uncomment the line below to use the more capable (higher cost) Sonnet.
# CLAUDE_MODEL=claude-sonnet-4-6
# PORT=3000
